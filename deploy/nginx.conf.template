server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    client_max_body_size 100m;   # 生圖時會上傳 Base64 參考圖

    # 圖庫素材（由 compose 以 volume 掛載）
    location /img/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location /thumbs/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location /data/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # 千問 / 豆包 CORS 轉發
    location = /api/proxy {
        proxy_pass http://proxy:3000;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 使用者自己的 ComfyUI（上傳參考圖 / 送出 workflow / 輪詢 / 取圖）
    # 上游位址由環境變數 COMFYUI_UPSTREAM 決定（見 docker-compose.yml）
    location /comfy/ {
        proxy_pass ${COMFYUI_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Vite 產出的雜湊檔名資源
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
